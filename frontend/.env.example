# ====================================
# FRONTEND ENVIRONMENT VARIABLES EXAMPLE
# ====================================
# Copia este archivo como .env y completa con tus valores reales
# IMPORTANTE: En Vite, todas las variables deben empezar con VITE_

# API BACKEND
VITE_API_URL=http://localhost:3000

# SUPABASE CONFIGURACIÓN (Frontend - Public Keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# APLICACIÓN
VITE_APP_TITLE=Fitness App CRM
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# CONFIGURACIÓN DE SUBIDA DE ARCHIVOS
VITE_MAX_FILE_SIZE=5242880
VITE_SUPPORTED_IMAGE_FORMATS=image/jpeg,image/png,image/gif,image/webp

# CONFIGURACIÓN DE CHARTS
VITE_CHART_THEME=light
VITE_DEFAULT_CHART_HEIGHT=400
